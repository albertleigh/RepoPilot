# Default: treat as text, normalize to LF in the repo
* text=auto eol=lf

# Windows-only scripts must keep CRLF
*.bat       text eol=crlf
*.cmd       text eol=crlf
*.ps1       text eol=crlf
*.psm1      text eol=crlf

# Explicit text types (defensive)
*.py        text eol=lf
*.md        text eol=lf
*.json      text eol=lf
*.txt       text eol=lf
*.toml      text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.cfg       text eol=lf
*.ini       text eol=lf
*.sh        text eol=lf

# Binary assets
*.png       binary
*.ico       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.webp      binary
*.pdf       binary
*.zip       binary
*.exe       binary
*.dll       binary

